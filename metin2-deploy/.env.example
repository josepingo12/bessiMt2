################################################################################
# Docker images
################################################################################
GAME_IMAGE=git.old-metin2.com/metin2/server:latest
WEB_IMAGE=git.old-metin2.com/metin2/web:latest

################################################################################
# MySQL settings
################################################################################
MYSQL_HOST=mysql
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_PORT=3306
MYSQL_EXTERNAL_PORT=3308
MYSQL_DB_ACCOUNT=account
MYSQL_DB_PLAYER=player
MYSQL_DB_COMMON=common
MYSQL_DB_LOG=log

################################################################################
# Web app settings
################################################################################

# General configuration
WEB_APP_NAME=Metin2
WEB_APP_ENV=production
WEB_APP_URL=https://your-domain.example
WEB_APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
WEB_EXTERNAL_PORT=8181

# E-mail configuration (per registrazione + reset password)
WEB_MAIL_MAILER=smtp
WEB_MAIL_HOST=smtp.gmail.com
WEB_MAIL_PORT=587
WEB_MAIL_USERNAME=your_email@gmail.com
WEB_MAIL_PASSWORD=GMAIL_APP_PASSWORD
WEB_MAIL_ENCRYPTION=tls
WEB_MAIL_FROM_ADDRESS=your_email@gmail.com
WEB_MAIL_FROM_NAME=BessiMT2

################################################################################
# Game server settings
################################################################################

# Global settings
TEST_SERVER=0

# DBCache settings
DB_ADDR=db
DB_PORT=15000

# Game settings
# Usare 127.0.0.1 se il client gira sulla stessa macchina del server.
# Usare l'IP LAN (es. 192.168.1.50) o il dominio se il client si connette da remoto.
PUBLIC_IP=127.0.0.1
GAME_MAX_LEVEL=105
